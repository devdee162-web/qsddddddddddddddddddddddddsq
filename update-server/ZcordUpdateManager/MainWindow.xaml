<Window x:Class="ZcordUpdateManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zcord Update Manager"
        Width="1400" Height="900" MinWidth="1100" MinHeight="700"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,24">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Border Width="38" Height="38" CornerRadius="10" Background="#7c3aed" Margin="0,0,12,0">
              <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Zcord" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="NavDashboard" Content="📊  Tableau de bord" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="dashboard"/>
          <Button x:Name="NavUpdates" Content="⬇️  Mises à jour" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="updates"/>
          <Button x:Name="NavCreate" Content="➕  Créer une MAJ" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="create"/>
          <Button x:Name="NavHistory" Content="🕐  Historique" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="history"/>
          <Button x:Name="NavLogs" Content="📋  Logs" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="logs"/>
          <Button x:Name="NavSettings" Content="⚙️  Paramètres" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="settings"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="8,16,8,0">
          <StackPanel>
            <TextBlock Text="Statut du système" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="En ligne" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
            <TextBlock x:Name="ApiStatus" Text="API : port 8743" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="32,20,32,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Gestionnaire de mises à jour" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageSub" Text="Gardez votre application à jour et sécurisée" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
          </StackPanel>
          <Button Content="↻ Actualiser" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
        <Grid>
        <!-- Dashboard -->
        <StackPanel x:Name="PageDashboard" Visibility="Visible">
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="Mises à jour disponibles" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                <TextBlock x:Name="KpiPending" Text="0" Foreground="{StaticResource PurpleBrush}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="Brouillons + MAJ locale" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0">
              <StackPanel>
                <TextBlock Text="Système à jour" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                <TextBlock x:Name="KpiHealth" Text="100%" Foreground="{StaticResource GreenBrush}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock x:Name="KpiSuccessHint" Text="Bon état général" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0">
              <StackPanel>
                <TextBlock Text="Zcord installé" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                <TextBlock x:Name="KpiInstalled" Text="—" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock x:Name="KpiInstalledHint" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Text="GitHub (publiée)" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                <TextBlock x:Name="KpiPublished" Text="—" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock x:Name="KpiGithubCount" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="0">
            <DockPanel LastChildFill="True">
              <Grid DockPanel.Dock="Top" Margin="20,20,20,0">
                <TextBlock Text="Actions requises" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="BtnPublishAll" Content="Publier les brouillons" Style="{StaticResource GhostBtn}"
                        HorizontalAlignment="Right" Click="PublishAll_Click"/>
              </Grid>
              <DataGrid x:Name="DashGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        Margin="8,12,8,8" AlternationCount="2"
                        CanUserAddRows="False" CanUserDeleteRows="False"
                        SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Version actuelle" Binding="{Binding CurrentVer}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Nouvelle version" Binding="{Binding Version}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="Priorité" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#332a1f4d"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Priority}" Value="Haute">
                                  <Setter Property="Background" Value="#33ef4444"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Priority}" Value="Basse">
                                  <Setter Property="Background" Value="#3322c55e"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Priority}" Value="Haute">
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Priority}" Value="Basse">
                                    <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Actions" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Télécharger" Click="PublishRow_Click" Tag="{Binding Id}" Padding="12,7">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsLocalClient}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Content="Publier" Click="PublishRow_Click" Tag="{Binding Id}" Padding="12,7">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsLocalClient}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DashEmpty" Text=""
                         Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                         Padding="32,48" FontSize="14" Visibility="Collapsed"/>
            </DockPanel>
          </Border>
        </StackPanel>

        <!-- Updates list -->
        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
          <Border Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="AllGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Margin="8" AlternationCount="2"
                      CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="100">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="100">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </StackPanel>

        <!-- Create -->
        <StackPanel x:Name="PageCreate" Visibility="Collapsed" MaxWidth="640">
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="Nouvelle mise à jour" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
              <TextBlock Text="Nom" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="InName" Margin="0,4,0,12" Padding="10" Background="#20000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
              <TextBlock Text="Version" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="InVersion" Margin="0,4,0,12" Padding="10" Background="#20000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Text="1.27.0"/>
              <TextBlock Text="Notes" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="InNotes" Margin="0,4,0,12" Padding="10" Height="80" AcceptsReturn="True"
                       Background="#20000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
              <TextBlock Text="Fichier Setup (optionnel)" Foreground="{StaticResource MutedBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                <TextBox x:Name="InFile" Width="360" IsReadOnly="True" Padding="10" Background="#20000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="Parcourir..." Margin="8,0,0,0" Padding="12,10" Click="BrowseFile_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button Content="Enregistrer brouillon" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Click="SaveDraft_Click"/>
                <Button Content="Enregistrer + Publier GitHub" Style="{StaticResource PrimaryBtn}" Click="SavePublish_Click"/>
              </StackPanel>
              <TextBlock x:Name="CreateStatus" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- History -->
        <StackPanel x:Name="PageHistory" Visibility="Collapsed">
          <Border Style="{StaticResource CardBorder}">
            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
          </Border>
        </StackPanel>

        <!-- Logs -->
        <StackPanel x:Name="PageLogs" Visibility="Collapsed">
          <Border Style="{StaticResource CardBorder}">
            <ListBox x:Name="LogsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas"/>
          </Border>
        </StackPanel>

        <!-- Settings -->
        <StackPanel x:Name="PageSettings" Visibility="Collapsed" MaxWidth="640">
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="GitHub Owner" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="SetOwner" Margin="0,4,0,12" Padding="10" Background="#20000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
              <TextBlock Text="GitHub Repo" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="SetRepo" Margin="0,4,0,12" Padding="10" Background="#20000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
              <Button Content="Sauvegarder" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="32,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock Text="Version du panel : 2.0.0 (C# WPF)" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          <TextBlock x:Name="StatusBar" Text="Prêt" Foreground="{StaticResource GreenBrush}" FontSize="12" HorizontalAlignment="Right"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
